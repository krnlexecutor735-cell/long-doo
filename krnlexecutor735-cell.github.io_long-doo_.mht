@charset "utf-8";

* { box-sizing: border-box; margin: 0px; padding: 0px; }

#loader-overlay { position: fixed; top: 0px; left: 0px; width: 100vw; height: 100vh; background: rgb(233, 238, 242); display: flex; align-items: center; justify-content: center; z-index: 99999; transition: opacity 0.5s; }

#fade { position: fixed; top: 0px; left: 0px; width: 100vw; height: 100vh; background: rgb(233, 238, 242); opacity: 0; pointer-events: none; z-index: 9999; display: flex; align-items: center; justify-content: center; transition: opacity 0.35s; }

#fade.in { opacity: 1; pointer-events: all; }

body { margin: 0px; background: rgb(233, 238, 242); display: flex; align-items: center; justify-content: center; min-height: 100vh; font-family: sans-serif; }

.container { position: relative; background: white; padding: 40px 50px; border-radius: 16px; box-shadow: rgba(0, 0, 0, 0.05) 0px 10px 25px; width: 420px; max-width: 90vw; transition: opacity 0.3s; }

.q-text { font-size: 22px; font-weight: 700; color: rgb(34, 34, 34); margin-bottom: 32px; }

.options { position: relative; display: flex; flex-direction: column; }

input[type="radio"] { display: none; }

.label { display: flex; align-items: center; gap: 16px; font-size: 24px; font-weight: bold; color: rgb(68, 68, 68); cursor: pointer; position: relative; z-index: 2; user-select: none; width: 100%; height: 60px; transition: color 0.25s; }

.label::before { content: ""; width: 28px; height: 28px; border: 3px solid rgb(204, 204, 204); border-radius: 50%; flex-shrink: 0; box-sizing: border-box; transition: border-color 0.25s; }

input:checked + .label::before { border-color: rgb(31, 111, 235); }

input:checked + .label { color: rgb(31, 111, 235); }

.worm { position: absolute; left: 7px; width: 14px; height: 14px; background: rgb(31, 111, 235); border-radius: 20px; transition: top 0.25s cubic-bezier(0.25, 0.1, 0.25, 1), height 0.25s cubic-bezier(0.25, 0.1, 0.25, 1); z-index: 1; pointer-events: none; }

.result-wrap { display: flex; align-items: center; justify-content: center; padding: 10px 0px; }

.score-ring { width: 120px; height: 120px; border: 5px solid rgb(31, 111, 235); border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; }

.score-num { font-size: 38px; font-weight: 700; color: rgb(31, 111, 235); line-height: 1; }

.score-of { font-size: 15px; color: rgb(187, 187, 187); }
